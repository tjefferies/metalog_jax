{
  "version": 2,
  "description": "metalog_jax GPU benchmark: batch fitting and sampling, time-boxed to the pod's deadline",
  "seed": 59,
  "data": {
    "samples_per_dataset": 200,
    "probabilities": "DEFAULT_Y",
    "boundedness": "STRICTLY_LOWER_BOUND",
    "lower_bound": 0.0
  },
  "num_terms": 10,
  "repetitions": 3,
  "repetition_budget_s": 30,
  "reserve_s": 30,
  "phases": [
    {
      "name": "check",
      "share": 0.02,
      "min_s": 60
    },
    {
      "name": "correctness",
      "share": 0.10,
      "min_s": 180,
      "datasets": 1024,
      "methods": ["ols", "feasible"]
    },
    {
      "name": "batches",
      "share": 0.43,
      "methods": {"feasible": 0.75, "ols": 0.25},
      "sizes": [1024, 4096, 32768, 131072, 524288, 2097152]
    },
    {
      "name": "chunked",
      "share": 0.13,
      "methods": {"feasible": 0.75, "ols": 0.25},
      "seconds": 120,
      "min_chunks": 2,
      "knee_tolerance": 0.05
    },
    {
      "name": "terms",
      "share": 0.20,
      "num_terms": [4, 6, 8, 10, 12],
      "datasets": 32768
    },
    {
      "name": "sampling",
      "share": 0.12,
      "kinds": {
        "ppf_jit": [1000000, 10000000, 100000000, 1000000000],
        "rvs_jax": [1000000, 10000000],
        "rvs_hdr": [1000000, 10000000],
        "cdf": [1000000, 10000000],
        "pdf_cdf": [1000000, 10000000]
      }
    }
  ]
}
